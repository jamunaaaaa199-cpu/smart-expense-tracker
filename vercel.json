{
  "version": 2,
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/api/index.js"
    },
    {
      "source": "/favicon.svg",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/income",
      "destination": "/income.html"
    },
    {
      "source": "/expenses",
      "destination": "/expenses.html"
    },
    {
      "source": "/expense",
      "destination": "/expenses.html"
    },
    {
      "source": "/reports",
      "destination": "/reports.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/logout",
      "destination": "/logout.html"
    }
  ]
}