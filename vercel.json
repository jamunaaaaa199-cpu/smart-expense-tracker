{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "smart-expense-tracker"
      }
    }
  ],
  "services": {
    "smart-expense-tracker": {
      "root": ".",
      "buildCommand": "npm install"
    }
  }
}
